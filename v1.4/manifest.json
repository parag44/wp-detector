{
  "manifest_version": 3,
  "name": "WPScout - Scout Any WordPress Website",
  "version": "1.4.1",
  "description": "Detect WordPress versions, themes, plugins, server technologies, caching systems, DNS records, and more with a single click.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-dim-16.png",
      "32": "icons/icon-dim-32.png",
      "48": "icons/icon-dim-48.png",
      "128": "icons/icon-dim-128.png"
    },
    "default_title": "WPScout - Scout Any WordPress Website",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://api.wordpress.org/*",
    "https://dns.google/*",
    "https://ipwho.is/*",
    "https://ps.w.org/*",
    "https://ts.w.org/*"
  ]
}
